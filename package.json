{
  "name": "by-tickets",
  "private": true,
  "description": "BY Tickets — Buy. Attend. Earn. Connect. Event ticketing & rewards on Stellar.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "setup": "npm --prefix apps/web install && node scripts/gen-secrets.mjs",
    "secrets": "node scripts/gen-secrets.mjs",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "contracts:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contracts.ps1 test",
    "contracts:lint": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contracts.ps1 lint",
    "contracts:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contracts.ps1 build",
    "contracts:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contracts.ps1 deploy",
    "contracts:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contracts.ps1 smoke",
    "contracts:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contracts.ps1 doctor",
    "db:test": "node -e \"console.error('The RLS suite is not run with Docker. Apply migrations through Supabase.'); process.exit(1)\"",
    "db:types": "node scripts/gen-db-types.mjs",
    "test": "npm --prefix apps/web run test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run contracts:test"
  }
}
